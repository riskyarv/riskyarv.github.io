---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import type { IconName } from '../../data/icons';
import c from '@content/pages/wat-is-onze-aanpak.json';

import partnersCar from '../../assets/img/partners-car.png';
import mensen from '../../assets/img/mensen.png';
import pdca from '../../assets/img/pdca.png';
import advies from '../../assets/img/advies.png';
import floppy from '../../assets/img/tech-floppy.png';
import hdd from '../../assets/img/tech-hardeschijf.png';
import monitor from '../../assets/img/tech-monitor.png';
import keyboard from '../../assets/img/tech-keyboard.png';
import pi from '../../assets/img/tech-raspberry-pi.png';
import camera from '../../assets/img/tech-camera.png';
import cd from '../../assets/img/tech-cd.png';
import aquarium from '../../assets/img/tech-aquarium.png';

const alts = c.technology.imageAlts;
const tech = [
  { src: floppy, alt: alts.floppy },
  { src: hdd, alt: alts.hdd },
  { src: monitor, alt: alts.monitor },
  { src: keyboard, alt: alts.keyboard },
  { src: pi, alt: alts.pi },
  { src: camera, alt: alts.camera },
  { src: cd, alt: alts.cd },
  { src: aquarium, alt: alts.aquarium },
];

const topics = [
  { id: 'mensen', label: c.people.title },
  { id: 'proces', label: c.process.title },
  { id: 'technologie', label: c.technology.title },
  { id: 'kennis', label: c.knowledge.title },
];
const crumbs = [{ label: c.hero.breadcrumb }];
---

<Base title={c.seo.title} description={c.seo.description} crumbs={crumbs}>
  <PageHero eyebrow={c.hero.eyebrow} title={c.hero.title} lead={c.hero.lead} crumbs={crumbs} />

  <section class="section" aria-labelledby="values-title">
    <div class="container container--wide">
      <p class="eyebrow">{c.values.eyebrow}</p>
      <h2 id="values-title" class="sr-only">{c.values.title}</h2>
      <ul class="values" role="list">
        {
          c.values.items.map((v, i) => (
            <li class:list={['card', 'value', 'reveal', { 'card--navy': i % 2 === 1 }]}>
              <div class="value__head">
                <span class="pill">
                  <Icon name={v.icon as IconName} /> {v.label}
                </span>
                <span class="value__nr" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
              </div>
              <h3 class="sr-only">{v.label}</h3>
              {v.paragraphsHtml.map((p) => (
                <p set:html={p} />
              ))}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="panel bg-yellow partners" aria-label={c.partners.label}>
    <div class="container split split--wide-text">
      <div>
        <p class="eyebrow">{c.partners.eyebrow}</p>
        <p class="partners__text" set:html={c.partners.textHtml} />
      </div>
      <Image src={partnersCar} alt="" class="illustration" style="--max:300px" widths={[300, 600]} sizes="300px" />
    </div>
  </section>

  <nav class="section section--tight pillars-nav" aria-label={c.topicsNav.label}>
    <div class="container">
      <ul role="list">
        {
          topics.map((t) => (
            <li>
              <a href={`#${t.id}`}>{t.label}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>

  <section id="mensen" class="pillar" aria-labelledby="mensen-title">
    <div class="container split">
      <div class="reveal">
        <Image
          src={mensen}
          alt={c.people.imageAlt}
          class="rounded pillar__photo"
          widths={[480, 720, 1000, 1486]}
          sizes="(min-width: 900px) 560px, 92vw"
        />
      </div>
      <div>
        <span class="pill pill--navy">01</span>
        <h2 id="mensen-title">{c.people.title}</h2>
        {c.people.paragraphs.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </section>

  <section id="proces" class="pillar" aria-labelledby="proces-title">
    <div class="container split split--reverse">
      <div class="reveal">
        <Image src={pdca} alt={c.process.imageAlt} class="illustration" style="--max:380px" widths={[380, 760]} sizes="380px" />
      </div>
      <div>
        <span class="pill pill--navy">02</span>
        <h2 id="proces-title">{c.process.title}</h2>
        {c.process.paragraphs.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </section>

  <section id="technologie" class="pillar" aria-labelledby="tech-title">
    <div class="container split">
      <div class="tech reveal">
        <div class="tech__track">
          {
            [...tech, ...tech].map((t, i) => (
              <Image
                src={t.src}
                alt={i < tech.length ? t.alt : ''}
                aria-hidden={i >= tech.length ? 'true' : undefined}
                height={110}
                densities={[1, 2]}
                class="tech__img"
              />
            ))
          }
        </div>
      </div>
      <div>
        <span class="pill pill--navy">03</span>
        <h2 id="tech-title">{c.technology.title}</h2>
        {c.technology.paragraphs.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </section>

  <section id="kennis" class="panel bg-navy kennis" aria-labelledby="kennis-title">
    <div class="container split split--wide-text">
      <div>
        <span class="pill">04</span>
        <h2 id="kennis-title">{c.knowledge.title}</h2>
        {c.knowledge.paragraphs.map((p) => <p>{p}</p>)}
        <ul class="kennis__list rich" role="list">
          {
            c.knowledge.items.map((k) => (
              <li>
                <Icon name="check" />
                {k.href ? <a href={k.href}>{k.label}</a> : <span>{k.label}</span>}
              </li>
            ))
          }
        </ul>
        <a class="btn" href={c.knowledge.cta.href}>
          <Icon name="envelope" /> {c.knowledge.cta.label}
        </a>
      </div>
      <Image src={advies} alt="" class="illustration" style="--max:360px" widths={[360, 647]} sizes="360px" />
    </div>
  </section>
</Base>

<style>
  .values {
    display: grid;
    gap: clamp(0.875rem, 0.6rem + 1vw, 1.25rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .value {
    border: 2px solid var(--navy);
  }

  .value__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.25rem;
  }

  .value .pill {
    font-size: var(--fs-sm);
    padding: 0.45em 1.1em;
  }

  .value__nr {
    font-size: 2.5rem;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--line);
  }

  .card--navy .value__nr {
    color: rgb(255 255 255 / 0.14);
  }

  .value p {
    font-size: var(--fs-sm);
  }

  @media (min-width: 640px) {
    .values {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1100px) {
    .values {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .partners__text {
    font-size: var(--fs-lead);
    line-height: 1.6;
    margin: 0;
    max-width: 52ch;
  }

  .partners :global(.illustration) {
    width: min(60%, 300px);
  }

  .pillars-nav ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pillars-nav a {
    display: inline-block;
    padding: 0.55rem 1.2rem;
    border: 1.5px solid var(--line);
    border-radius: 999px;
    color: var(--navy);
    font-size: var(--fs-sm);
    font-weight: 600;
    text-decoration: none;
    transition:
      border-color 0.2s,
      background-color 0.2s;
  }

  .pillars-nav a:hover {
    border-color: var(--navy);
    background: var(--yellow);
  }

  .pillar {
    padding-block: calc(var(--section) * 0.55);
  }

  .pillar:has(+ .kennis) {
    padding-bottom: var(--section);
  }

  .pillar .pill {
    margin-bottom: 1rem;
  }

  .pillar p {
    max-width: 62ch;
  }

  .pillar :global(.pillar__photo) {
    width: 100%;
    box-shadow: var(--shadow-l);
  }

  /* Technology marquee */
  .tech {
    overflow: hidden;
    padding-block: 2rem;
    border-radius: var(--radius-l);
    background: var(--surface);
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }

  .tech__track {
    display: flex;
    align-items: center;
    gap: 2.5rem;
    width: max-content;
    padding-right: 2.5rem;
  }

  .tech :global(.tech__img) {
    height: 110px;
    width: auto;
    max-width: none;
  }

  @media (prefers-reduced-motion: no-preference) {
    .tech__track {
      animation: marquee 32s linear infinite;
    }

    .tech:hover .tech__track {
      animation-play-state: paused;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tech {
      mask-image: none;
      padding: 1.5rem;
    }

    .tech__track {
      width: auto;
      flex-wrap: wrap;
      justify-content: center;
      gap: 1.5rem;
    }

    .tech :global(.tech__img) {
      height: 72px;
    }

    .tech :global(.tech__img[aria-hidden='true']) {
      display: none;
    }
  }

  .kennis {
    margin-bottom: var(--panel-gutter);
  }

  .kennis .pill {
    margin-bottom: 1rem;
  }

  .kennis__list {
    display: grid;
    gap: 0.6rem;
    margin: 1.5rem 0 2rem;
    padding: 0;
    list-style: none;
  }

  .kennis__list li {
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
  }

  .kennis__list :global(.icon) {
    flex: none;
    width: 1.35rem;
    height: 1.35rem;
    padding: 0.28rem;
    border-radius: 50%;
    background: var(--yellow);
    color: var(--navy);
    translate: 0 0.25em;
  }

  .kennis__list span {
    color: var(--white);
  }

  .kennis :global(.illustration) {
    width: min(70%, 360px);
  }
</style>
