---
import SetPage from '../../../../layouts/SetPage.astro';
import data from '@content/sets/hogeronderwijs.json';
import c from '@content/pages/set-hogeronderwijs.json';
---

<SetPage
  title={c.title}
  crumb={c.crumb}
  description={c.seo.description}
  current="hogeronderwijs"
  versions={data}
  note={c.note || undefined}
>
  {c.introHtml.map((p) => <p set:html={p} />)}
</SetPage>
