---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import StandardSet from '../../../components/StandardSet.astro';
import SetNav from '../../../components/SetNav.astro';
import Icon from '../../../components/Icon.astro';
import data from '@content/sets/standaard.json';
import c from '@content/pages/standaard-risicoset.json';

const [current, ...older] = data.nl;
---

<Base title={c.seo.title} description={c.seo.description} crumbs={c.crumbs}>
  <PageHero eyebrow={c.hero.eyebrow} title={c.hero.title} lead={c.hero.lead} crumbs={c.crumbs}>
    <div class="btn-row">
      <a class="btn btn--navy" href={c.hero.primary.href}>
        <Icon name="table-list" /> {c.hero.primary.label}
      </a>
      <a class="btn btn--ghost" href={c.hero.english.href} hreflang="en" lang="en">
        <Icon name="globe" /> {c.hero.english.label}
      </a>
    </div>
  </PageHero>

  <section class="section section--tight">
    <div class="container container--wide">
      <SetNav current="base" title={c.setNav.title} />
    </div>
  </section>

  <section class="section section--flush-top" aria-label={c.about.label}>
    <div class="container container--wide intro-grid">
      <div class="card why">
        <span class="icon-tile"><Icon name="lightbulb" /></span>
        <h2>{c.about.why.title}</h2>
        <p>{c.about.why.text}</p>
      </div>
      <div class="card card--navy cif">
        <span class="icon-tile"><Icon name="hospital" /></span>
        <h2 set:html={c.about.cif.titleHtml} />
        <p class="rich" set:html={c.about.cif.bodyHtml} />
      </div>
    </div>
  </section>

  <section id="risicoset" class="section section--flush-top set-section" aria-labelledby="set-title">
    <div class="container container--wide">
      <div class="set-head">
        <div>
          <p class="eyebrow">{c.set.eyebrow}</p>
          <h2 id="set-title">{current.label}</h2>
        </div>
      </div>
      <StandardSet data={current} />

      <h2 class="older-title">{c.set.olderTitle}</h2>
      {
        older.map((v) => (
          <details class="acc older">
            <summary>
              <span>{v.label}</span>
              <span class="acc__chev" aria-hidden="true">
                <Icon name="chevron-down" />
              </span>
            </summary>
            <div class="acc__body">
              <StandardSet data={v} />
            </div>
          </details>
        ))
      }

      <div class="outro">
        <p class="rich" set:html={c.outro.textHtml} />
        <p lang="en" class="rich">
          <Icon name="globe" /> <Fragment set:html={c.outro.englishHtml} />
        </p>
        <p class="small muted footnote">{c.outro.footnote}</p>
      </div>
    </div>
  </section>
</Base>

<style>
  .intro-grid {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 960px) {
    .intro-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .intro-grid h2 {
    font-size: var(--fs-h3);
  }

  .intro-grid p {
    margin: 0;
    font-size: var(--fs-sm);
  }

  .set-head {
    margin-bottom: 1.5rem;
  }

  .set-head h2 {
    margin: 0;
  }

  .older-title {
    margin-top: clamp(2.5rem, 2rem + 2vw, 4rem);
    font-size: var(--fs-h4);
  }

  .older > summary {
    font-size: var(--fs-body);
  }

  .older :global(.stdset .acc) {
    box-shadow: none;
  }

  .outro {
    margin-top: clamp(2.5rem, 2rem + 2vw, 4rem);
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }

  .outro p {
    max-width: 75ch;
  }

  .outro :global(.icon) {
    display: inline-block;
    vertical-align: -0.125em;
    color: var(--navy);
    margin-right: 0.35rem;
  }

  .footnote {
    margin-top: 1.5rem;
  }
</style>
