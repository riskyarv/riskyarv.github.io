---
import Base from '../../../../layouts/Base.astro';
import PageHero from '../../../../components/PageHero.astro';
import StandardSet from '../../../../components/StandardSet.astro';
import Icon from '../../../../components/Icon.astro';
import data from '@content/sets/standaard.json';
import c from '@content/pages/standard-risk-set-en.json';

const [current, ...older] = data.en;
---

<Base title={c.seo.title} description={c.seo.description} lang="en" crumbs={c.crumbs}>
  <PageHero eyebrow={c.hero.eyebrow} title={c.hero.title} crumbs={c.crumbs}>
    <p class="lead rich" set:html={c.hero.leadHtml} />
    <div class="btn-row">
      <a class="btn btn--navy" href={c.hero.primary.href}>
        <Icon name="table-list" /> {c.hero.primary.label}
      </a>
      <a class="btn btn--ghost" href={c.hero.dutch.href} hreflang="nl" lang="nl">
        {c.hero.dutch.label}
      </a>
    </div>
  </PageHero>

  <section id="risk-set" class="section" aria-labelledby="set-title">
    <div class="container container--wide">
      <p class="eyebrow">{c.set.eyebrow}</p>
      <h2 id="set-title">{current.label}</h2>
      <StandardSet data={current} lang="en" />

      <h2 class="older-title">{c.set.olderTitle}</h2>
      {
        older.map((v) => (
          <details class="acc older">
            <summary>
              <span>{v.label}</span>
              <span class="acc__chev" aria-hidden="true">
                <Icon name="chevron-down" />
              </span>
            </summary>
            <div class="acc__body">
              <StandardSet data={v} lang="en" />
            </div>
          </details>
        ))
      }
    </div>
  </section>
</Base>

<style>
  .older-title {
    margin-top: clamp(2.5rem, 2rem + 2vw, 4rem);
    font-size: var(--fs-h4);
  }

  .older > summary {
    font-size: var(--fs-body);
  }
</style>
