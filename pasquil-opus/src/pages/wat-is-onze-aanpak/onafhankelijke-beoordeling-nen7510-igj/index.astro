---
import { Image } from 'astro:assets';
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import Icon from '../../../components/Icon.astro';
import type { IconName } from '../../../data/icons';
import img from '../../../assets/img/onafhankelijke-beoordeling.png';
import c from '@content/pages/nen7510.json';
---

<Base title={c.seo.title} description={c.seo.description} crumbs={c.crumbs}>
  <PageHero eyebrow={c.hero.eyebrow} title={c.hero.title} lead={c.hero.lead} crumbs={c.crumbs}>
    <Image slot="media" src={img} alt="" loading="eager" style="width: min(100%, 232px)" />
  </PageHero>

  <article class="section">
    <div class="container container--narrow prose">
      <p class="lead intro">{c.intro}</p>
      {
        c.sections.map((s) => (
          <Fragment>
            <h2>{s.title}</h2>
            {s.paragraphs.map((p) => <p>{p}</p>)}
            {s.quote && <blockquote>{s.quote}</blockquote>}
          </Fragment>
        ))
      }
    </div>

    <div class="container principles-wrap">
      <ol class="principles" role="list">
        {
          c.principles.map((p, i) => (
            <li class:list={['card', 'reveal', { 'card--navy': i === 1 }]}>
              <div class="principle__head">
                <span class="icon-tile">
                  <Icon name={p.icon as IconName} />
                </span>
                <span class="principle__nr" aria-hidden="true">{i + 1}.</span>
              </div>
              <h3>{p.title}</h3>
              <p>{p.text}</p>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="container container--narrow">
      <div class="card card--yellow contact-card">
        <p set:html={c.contact.textHtml} />
        <a class="btn btn--navy" href={c.contact.cta.href}>
          <Icon name="envelope" /> {c.contact.cta.label}
        </a>
      </div>
    </div>
  </article>
</Base>

<style>
  .intro {
    color: var(--ink);
  }

  .principles-wrap {
    --container: 1100px;
    margin-block: clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  .principles {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .principle__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.25rem;
  }

  .principle__head .icon-tile {
    margin: 0;
  }

  .principle__nr {
    font-size: 2.5rem;
    font-weight: 800;
    line-height: 1;
    color: var(--line);
  }

  .card--navy .principle__nr {
    color: rgb(255 255 255 / 0.16);
  }

  .principles p {
    font-size: var(--fs-sm);
  }

  @media (min-width: 800px) {
    .principles {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .contact-card {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
  }

  .contact-card p {
    margin: 0;
    font-weight: 500;
  }

  .contact-card :global(.link) {
    text-decoration-color: var(--navy);
  }
</style>
