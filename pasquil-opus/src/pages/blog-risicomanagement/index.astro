---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import { sets } from '../../data/site';
import chapters from '@content/blog/risicomanagement.json';
import banner from '../../assets/img/risicomanagement-banner.png';
import c from '@content/pages/blog-risicomanagement.json';

const fill = (text: string, values: Record<string, unknown>) =>
  text.replace(/\{(\w+)\}/g, (m, key: string) => (key in values ? String(values[key]) : m));

const clean = (html: string) =>
  html
    .replaceAll('href="/wat-doen-we/template-standaard-risicoset/"', `href="${sets.base}"`)
    .replaceAll('href="http://www.risqui.nl/"', 'href="https://risqui.nl/"')
    .replace(/<a href="(https?:[^"]+)">/g, '<a href="$1" target="_blank" rel="noopener">')
    .replace(/<h4>(?:\s|<br\s*\/?>)+/g, '<h4>')
    .replace(/(?:<br\s*\/?>|\s)+<\/li>/g, '</li>');

const items = chapters.map((ch, i) => {
  const [, nr, title] = ch.title.match(/^(\d+)\.\s*(.+?)\.?$/) ?? [null, String(i + 1), ch.title];
  return { id: `hoofdstuk-${i + 1}`, nr, title, html: clean(ch.html) };
});

const words = [c.intro.steps.join(' '), ...chapters.map((ch) => ch.html.replace(/<[^>]+>/g, ' '))]
  .join(' ')
  .split(/\s+/)
  .filter(Boolean).length;
const minutes = Math.max(1, Math.round((words + 250) / 220));
---

<Base title={c.seo.title} description={c.seo.description} crumbs={c.crumbs} cta={false}>
  <PageHero eyebrow={c.hero.eyebrow} title={c.hero.title} crumbs={c.crumbs}>
    <ul class="meta" role="list">
      <li><Icon name="book-open" /> {fill(c.hero.chaptersLabel, { count: items.length })}</li>
      <li><Icon name="clock" /> {fill(c.hero.readingTimeLabel, { minutes })}</li>
    </ul>
  </PageHero>

  <article class="section blog">
    <div class="container container--narrow">
      <Image
        src={banner}
        alt=""
        class="banner"
        widths={[820, 1611]}
        sizes="(min-width: 900px) 820px, 92vw"
        loading="eager"
      />

      <div class="prose">
        <p class="lead intro">{c.intro.lead}</p>
        <ol class="steps" role="list">
          {c.intro.steps.map((s) => <li>{s}</li>)}
        </ol>
        {c.intro.paragraphs.map((p) => <p>{p}</p>)}
      </div>

      <figure class="video">
        <video
          src="/media/risk-pasquil.mp4"
          poster="/media/risk-pasquil-poster.jpg"
          width="1920"
          height="1080"
          controls
          muted
          loop
          playsinline
          preload="none"
          controlslist="nodownload"
          aria-label={c.video.label}
        >
        </video>
      </figure>

      <section class="chapters" aria-labelledby="chapters-title">
        <h2 id="chapters-title" class="chapters__title">{c.chapters.title}</h2>

        {
          items.map((ch, i) => (
            <details class="acc chapter" id={ch.id}>
              <summary>
                <span class="chapter__head">
                  <span class="chapter__nr" aria-hidden="true">
                    {ch.nr}
                  </span>
                  <h3>
                    <span class="sr-only">{fill(c.chapters.chapterLabel, { nr: ch.nr })} </span>
                    {ch.title}
                  </h3>
                </span>
                <span class="acc__chev" aria-hidden="true">
                  <Icon name="chevron-down" />
                </span>
              </summary>
              <div class="acc__body">
                <div class="prose chapter__body" set:html={ch.html} />
                {items[i + 1] && (
                  <a class="btn btn--sm btn--ghost next" href={`#${items[i + 1].id}`} data-open={items[i + 1].id}>
                    {fill(c.chapters.nextLabel, { title: items[i + 1].title })} <Icon name="arrow-right" />
                  </a>
                )}
              </div>
            </details>
          ))
        }
      </section>

      <div class="card card--yellow outro">
        <p set:html={c.outro.textHtml} />
        <div class="btn-row">
          <a class="btn btn--navy" href={c.outro.primary.href}>{c.outro.primary.label} <Icon name="arrow-right" /></a>
          <a class="btn btn--ghost" href={c.outro.secondary.href}>{c.outro.secondary.label}</a>
        </div>
      </div>
    </div>
  </article>
</Base>

<style>
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .meta li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.55);
    color: var(--navy);
    font-size: var(--fs-sm);
    font-weight: 700;
  }

  .banner {
    width: 100%;
    height: auto;
    margin-bottom: clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  .intro {
    color: var(--ink);
  }

  .steps {
    counter-reset: step;
    display: grid;
    gap: 0.5rem;
    padding: 0;
    list-style: none;
  }

  .steps li {
    counter-increment: step;
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: 0.85rem;
    align-items: start;
    margin: 0;
    padding: 0.85rem 1rem;
    border-radius: var(--radius-s);
    background: var(--surface);
    color: var(--ink);
  }

  .steps li::before {
    content: counter(step);
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--yellow);
    color: var(--navy);
    font-weight: 800;
    font-size: var(--fs-sm);
  }

  .video {
    margin: clamp(2rem, 1.5rem + 2vw, 3rem) 0;
    overflow: hidden;
    border-radius: var(--radius);
    background: #eef3ff;
    box-shadow: var(--shadow);
  }

  .video video {
    display: block;
    width: 100%;
    height: auto;
  }

  .chapters {
    margin-top: clamp(2.5rem, 2rem + 2vw, 4rem);
  }

  .chapters__title {
    margin-bottom: 1rem;
  }

  .chapter {
    scroll-margin-top: calc(var(--header-h) + 1rem);
  }

  .chapter__head {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .chapter__head h3 {
    margin: 0;
    font-size: var(--fs-h4);
    color: var(--navy);
  }

  .chapter__nr {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius-xs);
    background: var(--yellow);
    color: var(--navy);
    font-weight: 800;
    font-size: 1.125rem;
  }

  .chapter__body :global(h4) {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
    font-size: var(--fs-body);
  }

  .chapter__body :global(h4 br) {
    display: none;
  }

  .chapter__body :global(blockquote) {
    margin-inline: 0;
  }

  .next {
    margin-top: 2rem;
    white-space: normal;
    text-align: left;
  }

  .outro {
    margin-top: clamp(2.5rem, 2rem + 2vw, 4rem);
    gap: 1.25rem;
  }

  .outro p {
    margin: 0;
    font-weight: 500;
  }

  .outro :global(.link) {
    color: var(--navy);
    text-decoration-color: var(--navy);
  }
</style>

<script>
  const open = (id: string | null) => {
    if (!id) return;
    const d = document.getElementById(id);
    if (d instanceof HTMLDetailsElement) d.open = true;
  };

  document.querySelectorAll<HTMLAnchorElement>('[data-open]').forEach((a) =>
    a.addEventListener('click', () => open(a.dataset.open!)),
  );
  if (location.hash) open(location.hash.slice(1));
  addEventListener('hashchange', () => open(location.hash.slice(1)));

  const video = document.querySelector<HTMLVideoElement>('.video video');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  if (video && 'IntersectionObserver' in window) {
    let userPaused = false;
    let auto = false;
    video.addEventListener('pause', () => {
      if (!auto) userPaused = true;
      auto = false;
    });
    video.addEventListener('play', () => (userPaused = false));
    new IntersectionObserver(
      ([e]) => {
        if (e.isIntersecting) {
          if (!userPaused && !reduce.matches && video.paused) video.play().catch(() => {});
        } else if (!video.paused) {
          auto = true;
          video.pause();
        }
      },
      { threshold: 0.5 },
    ).observe(video);
  }
</script>
