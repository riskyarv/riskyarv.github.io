---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import Icon from '../../../components/Icon.astro';
import type { IconName } from '../../../data/icons';
import c from '@content/pages/samenwerken.json';

const crumbs = c.breadcrumbs;
const variants = ['', 'card--navy', 'card--yellow'];
---

<Base title={c.seo.title} description={c.seo.description} crumbs={crumbs}>
  <PageHero eyebrow={c.hero.eyebrow} title={c.hero.title} crumbs={crumbs} />

  <section class="section" aria-label={c.options.label}>
    <div class="container">
      <ol class="options" role="list">
        {
          c.options.items.map((item, i) => {
            const variant = variants[i % variants.length];
            return (
              <li class:list={['card', variant, 'option reveal']}>
                <span class="icon-tile">
                  <Icon name={item.icon as IconName} />
                </span>
                <h2>{item.title}</h2>
                <p>
                  {item.text}
                  {item.textLink && (
                    <>
                      {' '}
                      <a class="link" href={item.textLink.href}>
                        {item.textLink.label}
                      </a>
                      {item.textAfterLink}
                    </>
                  )}
                </p>
                <a class:list={['btn', variant === 'card--yellow' && 'btn--navy', 'btn--sm']} href={item.cta.href}>
                  {item.cta.href.startsWith('mailto:') ? (
                    <>
                      <Icon name="envelope" /> {item.cta.label}
                    </>
                  ) : (
                    <>
                      {item.cta.label} <Icon name="arrow-right" />
                    </>
                  )}
                </a>
              </li>
            );
          })
        }
      </ol>
    </div>
  </section>
</Base>

<style>
  .options {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 900px) {
    .options {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }
  }

  .option {
    margin: 0;
  }

  .option h2 {
    font-size: var(--fs-h3);
    margin-bottom: 0.75rem;
  }

  .option p {
    flex: 1;
  }

  .option .btn {
    align-self: flex-start;
    margin-top: 0.75rem;
  }

  .card--navy .link {
    color: var(--yellow);
    text-decoration-color: var(--yellow);
  }

  .card--navy .link:hover {
    color: var(--white);
  }
</style>
