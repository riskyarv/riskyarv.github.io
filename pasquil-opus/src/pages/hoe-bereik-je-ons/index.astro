---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import { site } from '../../data/site';
import type { IconName } from '../../data/icons';
import c from '@content/pages/hoe-bereik-je-ons.json';

const crumbs = c.breadcrumbs;
---

<Base title={c.seo.title} description={c.seo.description} crumbs={crumbs} cta={false}>
  <PageHero eyebrow={c.hero.eyebrow} title={c.hero.title} crumbs={crumbs} />

  <section class="section contact" aria-label={c.contact.label}>
    <div class="container">
      <ul class="channels" role="list">
        <li class="card card--navy channel">
          <span class="icon-tile"><Icon name="envelope" /></span>
          <h2 class="channel__title">{c.contact.mail.title}</h2>
          <a class="channel__value stretched" href={`mailto:${site.email}`}>{site.email}</a>
          <div class="copy-row" hidden>
            <button class="btn btn--ghost btn--sm" type="button" data-copy={site.email}>
              <Icon name="copy" /> <span data-label>{c.contact.mail.copyLabel}</span>
            </button>
            <span
              class="copy-status"
              role="status"
              aria-live="polite"
              data-copied={c.contact.mail.copiedMessage}
              data-failed={c.contact.mail.copyFailedMessage}
            ></span>
          </div>
          <span class="channel__go" aria-hidden="true"><Icon name="arrow-right" /></span>
        </li>
        <li class="card channel">
          <span class="icon-tile"><Icon name="location-dot" /></span>
          <h2 class="channel__title">{c.contact.location.title}</h2>
          <a class="channel__value stretched" href={site.maps} target="_blank" rel="noopener">
            <span>{site.street}</span>
            <span>{site.city}</span>
            <span class="sr-only">{c.contact.location.newWindowLabel}</span>
          </a>
          <span class="channel__go" aria-hidden="true"><Icon name="arrow-up-right-from-square" /></span>
        </li>
      </ul>

      <ul class="more" role="list">
        {
          c.more.items.map((item) => (
            <li>
              <a class="card more__card" href={item.href}>
                <span class="icon-tile">
                  <Icon name={item.icon as IconName} />
                </span>
                <span class="more__text">
                  <strong>{item.title}</strong>
                  <span>{item.text}</span>
                </span>
                <Icon name="arrow-right" />
              </a>
            </li>
          ))
        }
        <li>
          <a class="card more__card" href={site.linkedin} target="_blank" rel="noopener">
            <span class="icon-tile"><Icon name="linkedin-in" /></span>
            <span class="more__text">
              <strong>{c.more.linkedin.title}</strong>
              <span>{c.more.linkedin.text}<span class="sr-only"> {c.more.linkedin.newWindowLabel}</span></span>
            </span>
            <Icon name="arrow-up-right-from-square" />
          </a>
        </li>
      </ul>
    </div>
  </section>
</Base>

<style>
  .contact {
    padding-top: clamp(2rem, 1rem + 3vw, 3.5rem);
  }

  .channels {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 760px) {
    .channels {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.5rem;
    }
  }

  .channel {
    margin: 0;
    min-height: clamp(14rem, 10rem + 10vw, 19rem);
    justify-content: flex-end;
  }

  .channel .icon-tile {
    margin-bottom: auto;
  }

  .channel__title {
    margin: 1.5rem 0 0.35rem;
    font-size: var(--fs-sm);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: inherit;
    opacity: 0.75;
  }

  .channel__value {
    display: flex;
    flex-direction: column;
    color: var(--navy);
    font-size: clamp(1.5rem, 1rem + 2.2vw, 2.5rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.02em;
    overflow-wrap: anywhere;
  }

  .card--navy .channel__value {
    color: var(--white);
  }

  .channel__value:focus-visible {
    outline: none;
  }

  .channel:has(.channel__value:focus-visible) {
    outline: 3px solid var(--yellow);
    outline-offset: 3px;
  }

  .channel__go {
    position: absolute;
    top: clamp(1.375rem, 1rem + 1vw, 2rem);
    right: clamp(1.375rem, 1rem + 1vw, 2rem);
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--surface);
    color: var(--navy);
    transition:
      transform 0.35s var(--ease-out),
      background-color 0.25s;
  }

  .card--navy .channel__go {
    background: rgb(255 255 255 / 0.1);
    color: var(--yellow);
  }

  .channel:hover .channel__go {
    transform: translate(3px, -3px);
    background: var(--yellow);
    color: var(--navy);
  }

  .channel.card--navy:hover {
    border-color: var(--navy);
  }

  .copy-row {
    position: relative;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  .copy-row[hidden] {
    display: none;
  }

  .copy-status {
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--yellow);
  }

  .more {
    display: grid;
    gap: 0.75rem;
    margin: clamp(2rem, 1.5rem + 2vw, 3rem) 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 900px) {
    .more {
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
    }
  }

  .more li {
    margin: 0;
  }

  .more__card {
    flex-direction: row;
    align-items: center;
    gap: 1rem;
    height: 100%;
    padding: 1.1rem 1.25rem;
    color: var(--navy);
  }

  .more__card .icon-tile {
    width: 2.75rem;
    height: 2.75rem;
    margin: 0;
    font-size: 1.1rem;
  }

  .more__text {
    display: grid;
    flex: 1;
    gap: 0.1rem;
    font-size: var(--fs-sm);
    color: var(--text);
  }

  .more__text strong {
    color: var(--navy);
    font-size: var(--fs-body);
  }

  .more__card > :global(.icon):last-child {
    transition: transform 0.35s var(--ease-out);
  }

  .more__card:hover > :global(.icon):last-child {
    transform: translateX(3px);
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-copy]');
  const row = btn?.closest<HTMLElement>('.copy-row');
  const status = row?.querySelector<HTMLElement>('.copy-status');
  if (btn && row && navigator.clipboard) {
    row.hidden = false;
    let timer: number | undefined;
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy!);
        if (status) status.textContent = status.dataset.copied ?? '';
      } catch {
        if (status) status.textContent = status.dataset.failed ?? '';
      }
      clearTimeout(timer);
      timer = window.setTimeout(() => status && (status.textContent = ''), 2500);
    });
  }
</script>
