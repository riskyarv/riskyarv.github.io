---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import type { IconName } from '../../data/icons';
import logo from '../../assets/img/risqui-logo.png';
import c from '@content/pages/risqui.json';

const crumbs = c.breadcrumbs;
---

<Base title={c.seo.title} description={c.seo.description} crumbs={crumbs}>
  <PageHero eyebrow={c.hero.eyebrow} title={c.hero.title} lead={c.hero.lead} crumbs={crumbs}>
    <div class="btn-row">
      <a class="btn" href={c.hero.cta.href} target="_blank" rel="noopener">
        {c.hero.cta.label} <Icon name="arrow-up-right-from-square" /><span class="sr-only"> {c.hero.newWindowLabel}</span>
      </a>
    </div>
    <div slot="media" class="logo-card">
      <Image src={logo} alt={c.hero.logoAlt} widths={[360, 720]} sizes="360px" loading="eager" />
    </div>
  </PageHero>

  <section class="section">
    <div class="container story">
      <div class="prose story__text">
        <p class="lead">{c.story.lead}</p>
        <p>
          {c.story.moreText}{' '}
          <a href={c.story.moreLink.href} target="_blank" rel="noopener">{c.story.moreLink.label}<span class="sr-only"> {c.story.newWindowLabel}</span></a>
        </p>
      </div>

      <ul class="related" role="list">
        {
          c.related.items.map((item) => (
            <li>
              <a class="card related__card" href={item.href}>
                <span class="icon-tile">
                  <Icon name={item.icon as IconName} />
                </span>
                <span>
                  <strong>{item.title}</strong>
                  <span class="related__sub">{item.text}</span>
                </span>
                <Icon name="arrow-right" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  .logo-card {
    display: grid;
    place-items: center;
    width: min(100%, clamp(15rem, 60vw, 26rem));
    aspect-ratio: 4 / 3;
    margin-inline: auto;
    padding: clamp(1.5rem, 1rem + 3vw, 3rem);
    border-radius: var(--radius-l);
    background: var(--white);
    box-shadow: var(--shadow-l);
    rotate: -2deg;
  }

  .logo-card img {
    width: 100%;
    height: auto;
  }

  .story {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(2rem, 1rem + 3vw, 3.5rem);
  }

  @media (min-width: 960px) {
    .story {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
      align-items: start;
    }
  }

  .story__text .lead {
    color: var(--ink);
  }

  .related {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .related li {
    margin: 0;
  }

  .related__card {
    flex-direction: row;
    align-items: center;
    gap: 1rem;
    color: var(--navy);
  }

  .related__card .icon-tile {
    margin: 0;
    flex: none;
  }

  .related__card > span:nth-child(2) {
    display: grid;
    flex: 1;
    min-width: 0;
    gap: 0.15rem;
  }

  .related__sub {
    font-size: var(--fs-sm);
    color: var(--text);
  }

  .related__card > :global(.icon):last-child {
    flex: none;
    transition: transform 0.35s var(--ease-out);
  }

  .related__card:hover > :global(.icon):last-child {
    transform: translateX(3px);
  }
</style>
