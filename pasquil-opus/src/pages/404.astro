---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import laptop from '../assets/img/flying-laptop.png';
import c from '@content/pages/404.json';
---

<Base title={c.seo.title} description={c.seo.description} noindex cta={false}>
  <section class="nf panel bg-navy">
    <div class="container nf__inner">
      <div class="nf__art" aria-hidden="true">
        <span class="nf__code">404</span>
        <Image src={laptop} alt="" class="nf__laptop" width={247} densities={[1, 2]} loading="eager" />
      </div>
      <div class="nf__text">
        <p class="eyebrow">{c.notFound.eyebrow}</p>
        <h1>{c.notFound.title}</h1>
        <p class="lead">{c.notFound.lead}</p>
        <div class="btn-row">
          <a class="btn" href={c.notFound.primary.href}><Icon name="house" /> {c.notFound.primary.label}</a>
          <a class="btn btn--ghost" href={c.notFound.secondary.href}><Icon name="envelope" /> {c.notFound.secondary.label}</a>
        </div>
        <ul class="nf__links" role="list">
          {
            c.notFound.links.map((l) => (
              <li>
                <a class="arrow-link" href={l.href}>
                  {l.label} <Icon name="arrow-right" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf {
    margin-top: var(--panel-gutter);
    margin-bottom: var(--panel-gutter);
  }

  .nf__inner {
    display: grid;
    gap: 2.5rem;
    align-items: center;
    padding-block: clamp(3rem, 2rem + 5vw, 6rem);
  }

  @media (min-width: 900px) {
    .nf__inner {
      grid-template-columns: 1fr 1.2fr;
    }
  }

  .nf__art {
    position: relative;
    display: grid;
    place-items: center;
  }

  .nf__code {
    font-size: clamp(6rem, 3rem + 14vw, 14rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.05em;
    color: var(--yellow);
  }

  .nf__laptop {
    position: absolute;
    width: clamp(7rem, 4rem + 10vw, 13rem);
    height: auto;
    right: 4%;
    top: -12%;
    animation: float 5s ease-in-out infinite;
  }

  @keyframes float {
    50% {
      translate: 0 -12px;
      rotate: -3deg;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nf__laptop {
      animation: none;
    }
  }

  .nf__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    margin: 2rem 0 0;
    padding: 1.5rem 0 0;
    border-top: 1px solid rgb(255 255 255 / 0.15);
    list-style: none;
  }

  .nf__links li {
    margin: 0;
  }
</style>
