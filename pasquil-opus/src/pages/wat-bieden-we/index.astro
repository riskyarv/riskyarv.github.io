---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import { services } from '../../data/site';
import c from '@content/pages/wat-bieden-we.json';

import imgAdvies from '../../assets/img/advies.png';
import imgRisico from '../../assets/img/risicomanagement.png';
import imgAudits from '../../assets/img/audits.png';
import imgOnafh from '../../assets/img/onafhankelijke-beoordeling.png';
import imgInterim from '../../assets/img/ad-interim.png';
import imgFg from '../../assets/img/fg.png';
import imgAwareness from '../../assets/img/awareness.png';
import imgSecurity from '../../assets/img/security-assessment.png';
import imgCrisis from '../../assets/img/crisis.png';

interface Media {
  side: 'left' | 'right';
  img?: ImageMetadata;
  gif?: string;
  max?: number;
}

const media: Record<string, Media> = {
  advies: { side: 'left', img: imgAdvies, max: 380 },
  risicomanagement: { side: 'left', img: imgRisico, max: 400 },
  implementaties: { side: 'right', gif: '/media/pdca.gif' },
  audits: { side: 'right', img: imgAudits, max: 270 },
  onafhankelijkebeoordeling: { side: 'left', img: imgOnafh, max: 230 },
  adinterim: { side: 'right', img: imgInterim, max: 420 },
  fgasaservice: { side: 'left', img: imgFg, max: 440 },
  awareness: { side: 'right', img: imgAwareness, max: 300 },
  securityassessment: { side: 'left', img: imgSecurity, max: 170 },
  cybercrisissimulatie: { side: 'right', img: imgCrisis, max: 240 },
};
const bgs = ['navy', 'yellow', 'soft'] as const;

interface Detail {
  id: string;
  imageAlt?: string;
  paragraphsHtml: string[];
  cta: { label: string; href: string };
}

const byId = new Map(services.map((s) => [s.id, s]));
const ordered = (c.services.items as Detail[])
  .filter((d) => byId.has(d.id))
  .map((d, i) => {
    const s = byId.get(d.id)!;
    const m: Media = media[d.id] ?? { side: i % 2 ? 'right' : 'left' };
    return { ...d, ...m, bg: bgs[i % bgs.length], title: s.title, icon: s.icon };
  });
const crumbs = [{ label: c.hero.breadcrumb }];
---

<Base title={c.seo.title} description={c.seo.description} crumbs={crumbs}>
  <PageHero eyebrow={c.hero.eyebrow} title={c.hero.title} lead={c.hero.lead} crumbs={crumbs} />

  <nav class="chips-bar" aria-label={c.servicesNav.label}>
    <div class="container container--wide">
      <ul class="chips" role="list">
        {
          ordered.map((s) => (
            <li>
              <a href={`#${s.id}`} class="chip" data-spy={s.id}>
                <Icon name={s.icon} />
                <span>{s.title}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>

  <div class="services">
    {
      ordered.map((s, i) => (
        <section id={s.id} class:list={['panel', `bg-${s.bg}`, 'service']} aria-labelledby={`${s.id}-title`}>
          <div class:list={['container', 'split', 'split--wide-text', { 'split--reverse': s.side === 'right' }]}>
            <div class="service__media">
              {s.img && (
                <Image
                  src={s.img}
                  alt=""
                  class="illustration"
                  style={`--max:${s.max ?? 420}px`}
                  widths={[Math.min(s.img.width, s.max ?? 420), Math.min(s.img.width, (s.max ?? 420) * 2)]}
                  sizes={`(min-width: 900px) ${s.max ?? 420}px, 70vw`}
                  loading={i < 2 ? 'eager' : 'lazy'}
                />
              )}
              {s.gif && (
                <div class="gif-card">
                  <img
                    src={s.gif}
                    alt={s.imageAlt ?? ''}
                    width="400"
                    height="400"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              )}
            </div>
            <div class="service__text">
              <div class="service__label">
                <span class="icon-tile">
                  <Icon name={s.icon} />
                </span>
                <span class="service__nr">
                  {String(i + 1).padStart(2, '0')} / {ordered.length}
                </span>
              </div>
              <h2 id={`${s.id}-title`}>{s.title}</h2>
              <div class="rich">
                {s.paragraphsHtml.map((p) => (
                  <p set:html={p} />
                ))}
              </div>
              {s.cta.label && (
                <a class="btn" href={s.cta.href}>
                  {s.cta.label} <Icon name="arrow-right" />
                </a>
              )}
            </div>
          </div>
        </section>
      ))
    }
  </div>
</Base>

<style>
  .chips-bar {
    position: sticky;
    top: var(--header-h);
    z-index: 50;
    padding-block: 0.7rem;
    background: rgb(255 255 255 / 0.9);
    backdrop-filter: saturate(1.4) blur(12px);
    -webkit-backdrop-filter: saturate(1.4) blur(12px);
    border-bottom: 1px solid var(--line);
  }

  .chips {
    position: relative;
    display: flex;
    gap: 0.5rem;
    margin: 0;
    padding: 0.2rem;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
    mask-image: linear-gradient(90deg, #000 calc(100% - 2.5rem), transparent);
  }

  .chips::-webkit-scrollbar {
    display: none;
  }

  .chips li {
    flex: none;
    scroll-snap-align: start;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.95rem;
    border: 1.5px solid var(--line);
    border-radius: 999px;
    background: var(--white);
    color: var(--navy);
    font-size: var(--fs-xs);
    font-weight: 600;
    white-space: nowrap;
    text-decoration: none;
    transition:
      background-color 0.2s,
      border-color 0.2s,
      color 0.2s;
  }

  .chip :global(.icon) {
    opacity: 0.7;
  }

  .chip:hover {
    border-color: var(--navy);
  }

  .chip[aria-current='true'] {
    border-color: var(--navy);
    background: var(--navy);
    color: var(--white);
  }

  .chip[aria-current='true'] :global(.icon) {
    color: var(--yellow);
    opacity: 1;
  }

  .services {
    padding-block: var(--panel-gutter);
  }

  .service {
    scroll-margin-top: calc(var(--header-h) + 4.25rem);
  }

  .service__label {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .service__label .icon-tile {
    margin: 0;
  }

  .service__nr {
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    opacity: 0.65;
  }

  .service__text .rich {
    max-width: 68ch;
  }

  .service__text .btn {
    margin-top: 0.75rem;
  }

  .service__media {
    display: grid;
    place-items: center;
  }

  .gif-card {
    width: min(100%, 420px);
    padding: clamp(1rem, 0.5rem + 2vw, 2rem);
    border-radius: var(--radius-l);
    background: #fcfafc;
    box-shadow: var(--shadow);
  }

  .gif-card img {
    width: 100%;
  }

  @media (max-width: 899px) {
    .service__media :global(.illustration) {
      width: min(62%, var(--max, 420px));
    }

    .gif-card {
      width: min(76%, 320px);
    }
  }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('.chips');
  const chips = new Map<string, HTMLAnchorElement>();
  document.querySelectorAll<HTMLAnchorElement>('.chip[data-spy]').forEach((a) => chips.set(a.dataset.spy!, a));

  const setActive = (id: string) => {
    chips.forEach((a, key) => {
      if (key !== id) {
        a.removeAttribute('aria-current');
        return;
      }
      a.setAttribute('aria-current', 'true');
      if (!bar) return;
      const li = a.parentElement!;
      const left = li.offsetLeft - bar.clientWidth / 2 + li.clientWidth / 2;
      const smooth = !matchMedia('(prefers-reduced-motion: reduce)').matches;
      bar.scrollTo({ left, behavior: smooth ? 'smooth' : 'auto' });
    });
  };

  const io = new IntersectionObserver(
    (entries) => entries.forEach((e) => e.isIntersecting && setActive(e.target.id)),
    { rootMargin: '-40% 0px -55% 0px' },
  );

  const sections = document.querySelectorAll<HTMLElement>('.service[id]');
  sections.forEach((s) => io.observe(s));

  let ticking = false;
  addEventListener(
    'scroll',
    () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        ticking = false;
        if (sections[0] && sections[0].getBoundingClientRect().top > innerHeight * 0.45) {
          chips.forEach((a) => a.removeAttribute('aria-current'));
          bar?.scrollTo({ left: 0 });
        }
      });
    },
    { passive: true },
  );
</script>
