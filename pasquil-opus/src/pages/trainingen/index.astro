---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import type { IconName } from '../../data/icons';
import c from '@content/pages/trainingen.json';

const crumbs = c.breadcrumbs;
---

<Base title={c.seo.title} description={c.seo.description} crumbs={crumbs}>
  <PageHero eyebrow={c.hero.eyebrow} title={c.hero.title} crumbs={crumbs}>
    <p class="lead">{c.hero.lead}</p>
  </PageHero>

  <section class="section" aria-labelledby="overzicht-title">
    <div class="container">
      <h2 id="overzicht-title" class="overview-title">{c.overview.title}</h2>

      <ul class="trainings" role="list">
        {
          c.overview.items.map((t) => (
            <li class="card training reveal">
              <span class="icon-tile">
                <Icon name={t.icon as IconName} />
              </span>
              <h3>
                <a class="stretched" href={t.href} target="_blank" rel="noopener">
                  {t.title}
                  <span class="sr-only"> {c.overview.newWindowLabel}</span>
                </a>
              </h3>
              <p>{t.text}</p>
              <dl class="meta">
                <div>
                  <dt>
                    <Icon name="calendar" /> {c.overview.startLabel}
                  </dt>
                  <dd>{t.start}</dd>
                </div>
                <div>
                  <dt>
                    <Icon name="clock" /> {c.overview.durationLabel}
                  </dt>
                  <dd>{t.duration}</dd>
                </div>
              </dl>
              <span class="training__cta" aria-hidden="true">
                {c.overview.cta} <Icon name="arrow-up-right-from-square" />
              </span>
            </li>
          ))
        }
        <li class="card card--navy training training--custom reveal">
          <span class="icon-tile">
            <Icon name="screwdriver-wrench" />
          </span>
          <h3>{c.custom.title}</h3>
          <p class="custom__sub">{c.custom.subtitle}</p>
          <ul class="check-list" role="list">
            {
              c.custom.items.map((item) => (
                <li>
                  <Icon name="check" />
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>
          <a class="btn btn--sm" href={c.custom.cta.href}>{c.custom.cta.label} <Icon name="arrow-right" /></a>
        </li>
      </ul>
    </div>
  </section>
</Base>

<style>
  .overview-title {
    max-width: 30ch;
    margin-bottom: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    font-size: var(--fs-h3);
  }

  .trainings {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 700px) {
    .trainings {
      grid-template-columns: repeat(2, 1fr);
    }

    .training--custom {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 1050px) {
    .trainings {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }

    .training--custom {
      grid-column: auto;
    }
  }

  .training {
    margin: 0;
  }

  .training h3 a {
    color: var(--navy);
  }

  .training p {
    flex: 0;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0.25rem 0 1.5rem;
  }

  .meta div {
    display: inline-flex;
    gap: 0.35rem;
    align-items: center;
    padding: 0.4rem 0.8rem;
    border-radius: 999px;
    background: var(--surface);
    font-size: var(--fs-sm);
  }

  .meta dt {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--text);
  }

  .meta dd {
    margin: 0;
    font-weight: 700;
    color: var(--navy);
  }

  .training__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: auto;
    font-weight: 700;
    font-size: var(--fs-sm);
    color: var(--navy);
  }

  .training__cta :global(.icon) {
    transition: transform 0.35s var(--ease-out);
  }

  .training:hover .training__cta :global(.icon) {
    transform: translate(2px, -2px);
  }

  .custom__sub {
    font-weight: 700;
    color: var(--yellow);
  }

  .training--custom .check-list {
    margin: 0 0 1.5rem;
    color: var(--white);
  }

  .training--custom .btn {
    align-self: flex-start;
    margin-top: auto;
  }

  .training:has(.stretched:focus-visible) {
    outline: 3px solid var(--navy);
    outline-offset: 3px;
  }

  .stretched:focus-visible {
    outline: none;
  }
</style>
