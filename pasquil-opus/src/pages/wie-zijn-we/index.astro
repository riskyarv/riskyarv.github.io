---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import type { IconName } from '../../data/icons';
import c from '@content/pages/wie-zijn-we.json';
import hoodie from '../../assets/img/hoodie.png';
import arvid from '../../assets/img/team-arvid.jpg';
import lotte from '../../assets/img/team-lotte.jpg';
import jelle from '../../assets/img/team-jelle.jpg';
import mariette from '../../assets/img/team-mariette.png';
import daniel from '../../assets/img/team-daniel.jpg';
import lynley from '../../assets/img/team-lynley.jpg';

const crumbs = [{ label: c.hero.breadcrumb }];

const photos: Record<string, ImageMetadata | undefined> = { arvid, lotte, jelle, mariette, daniel, lynley };
const members = c.team.members.map((m) => ({ ...m, img: photos[m.photo] }));
const withName = (text: string, name: string) => text.replaceAll('{name}', () => name);
---

<Base title={c.seo.title} description={c.seo.description} crumbs={crumbs}>
  <PageHero eyebrow={c.hero.eyebrow} title={c.hero.title} crumbs={crumbs}>
    <div class="story">
      {c.hero.paragraphs.map((p) => <p>{p}</p>)}
    </div>
    <ul class="facts" role="list">
      {
        c.hero.facts.map((f) => (
          <li>
            <Icon name={f.icon as IconName} /> {f.label}
          </li>
        ))
      }
    </ul>
    <Image
      slot="media"
      src={hoodie}
      alt=""
      class="illustration"
      style="--max: clamp(220px, 60vw, 440px)"
      widths={[440, 880]}
      sizes="(min-width: 900px) 440px, 80vw"
      loading="eager"
    />
  </PageHero>

  <section class="section" aria-labelledby="team-title">
    <div class="container">
      <div class="team-head">
        <p class="eyebrow">{c.team.eyebrow}</p>
        <h2 id="team-title">{c.team.title}</h2>
      </div>
      <ul class="team" role="list">
        {
          members.map((m, i) => (
            <li class="member reveal">
              <div class="member__photo">
                {m.img && (
                  <Image
                    src={m.img}
                    alt={withName(c.team.photoAlt, m.name)}
                    widths={[320, 480, 720]}
                    sizes="(min-width: 1100px) 360px, (min-width: 640px) 45vw, 176px"
                    loading={i < 3 ? 'eager' : 'lazy'}
                  />
                )}
              </div>
              <div class="member__body">
                <div class="member__head">
                  <h3>{m.name}</h3>
                  <a
                    class="member__li"
                    href={m.linkedin}
                    target="_blank"
                    rel="noopener"
                    aria-label={withName(c.team.linkedinLabel, m.name)}
                  >
                    <Icon name="linkedin-in" />
                  </a>
                </div>
                <p>{m.text}</p>
              </div>
            </li>
          ))
        }
      </ul>

      <div class="card card--navy join reveal">
        <span class="icon-tile"><Icon name="briefcase" /></span>
        <div>
          <h3>{c.join.title}</h3>
          <p>{c.join.text}</p>
        </div>
        <a class="btn" href={c.join.cta.href}>{c.join.cta.label} <Icon name="arrow-right" /></a>
      </div>
    </div>
  </section>
</Base>

<style>
  .story p {
    max-width: 62ch;
    color: var(--ink);
  }

  .story p:first-child {
    font-size: var(--fs-lead);
    line-height: 1.6;
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.75rem 0 0;
    padding: 0;
    list-style: none;
  }

  .facts li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    padding: 0.5rem 0.95rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.55);
    color: var(--navy);
    font-size: var(--fs-sm);
    font-weight: 700;
  }

  .team-head {
    margin-bottom: clamp(1.5rem, 1rem + 2vw, 2.5rem);
  }

  .team {
    display: grid;
    gap: clamp(2rem, 1.25rem + 2vw, 3rem) clamp(1.25rem, 0.75rem + 1.5vw, 2rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 640px) {
    .team {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1000px) {
    .team {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .member {
    display: flex;
    flex-direction: column;
    margin: 0;
  }

  .member__photo {
    overflow: hidden;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius);
    background: var(--surface);
  }

  .member__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 20%;
    transition: transform 0.6s var(--ease-out);
  }

  .member:hover .member__photo img {
    transform: scale(1.04);
  }

  .member__body {
    padding: 1.25rem 0.25rem 0;
  }

  .member__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.6rem;
  }

  .member__head h3 {
    margin: 0;
    font-size: var(--fs-h3);
  }

  .member__body p {
    margin: 0;
    font-size: var(--fs-sm);
  }

  @media (max-width: 639px) {
    .member {
      display: grid;
      grid-template-columns: 5.5rem 1fr;
      column-gap: 1rem;
      align-items: center;
    }

    .member__photo {
      aspect-ratio: 1;
      border-radius: var(--radius-s);
    }

    .member__body {
      display: contents;
    }

    .member__head {
      margin: 0;
    }

    .member__body p {
      grid-column: 1 / -1;
      margin-top: 1rem;
    }
  }

  .member__li {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--navy);
    color: var(--white);
    font-size: 1rem;
    transition:
      background-color 0.25s,
      color 0.25s,
      transform 0.35s var(--ease-out);
  }

  .member__li:hover {
    background: var(--yellow);
    color: var(--navy);
    transform: translateY(-2px);
  }

  .join {
    margin-top: clamp(2.5rem, 1.5rem + 3vw, 4rem);
    gap: 1rem 1.5rem;
  }

  .join .icon-tile {
    margin: 0;
  }

  .join h3 {
    margin-bottom: 0.25rem;
    font-size: var(--fs-h3);
  }

  .join p {
    margin: 0;
  }

  @media (min-width: 760px) {
    .join {
      flex-direction: row;
      align-items: center;
    }

    .join > div {
      flex: 1;
    }
  }
</style>
