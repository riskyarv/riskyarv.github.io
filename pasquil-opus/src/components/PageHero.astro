---
import Breadcrumbs, { type Crumb } from './Breadcrumbs.astro';

interface Props {
  title: string;
  eyebrow?: string;
  lead?: string;
  crumbs?: Crumb[];
  variant?: 'yellow' | 'navy' | 'soft';
}

const { title, eyebrow, lead, crumbs, variant = 'yellow' } = Astro.props;
const hasMedia = Astro.slots.has('media');
---

<section class:list={['page-hero', `bg-${variant}`, `page-hero--${variant}`]}>
  <div class:list={['container', { 'page-hero__grid': hasMedia }]}>
    <div class="page-hero__text">
      {crumbs && <Breadcrumbs items={crumbs} />}
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1 set:html={title} />
      {lead && <p class="lead">{lead}</p>}
      <slot />
    </div>
    {
      hasMedia && (
        <div class="page-hero__media">
          <slot name="media" />
        </div>
      )
    }
  </div>
  <slot name="after" />
</section>

<style>
  .page-hero {
    overflow: clip;
  }

  .page-hero--yellow::after {
    content: '';
    position: absolute;
    right: -6rem;
    top: -6rem;
    width: 22rem;
    aspect-ratio: 1;
    border-radius: 50%;
    border: 3.5rem solid rgb(255 255 255 / 0.22);
    pointer-events: none;
  }

  .page-hero--navy::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(60rem 30rem at 100% 0%, rgb(252 186 4 / 0.12), transparent 60%);
    pointer-events: none;
  }

  .page-hero .container {
    position: relative;
    z-index: 1;
  }

  .page-hero__grid {
    display: grid;
    gap: 2rem 4rem;
    align-items: center;
  }

  .page-hero__media :global(img) {
    width: min(100%, 420px);
    margin-inline: auto;
  }

  @media (min-width: 900px) {
    .page-hero__grid {
      grid-template-columns: 1.4fr 1fr;
    }
  }
</style>
