---
import Icon from './Icon.astro';
import { fill } from '../data/site';
import setUi from '@content/set-ui.json';

const t = setUi.riskTable;

export interface Measure {
  name: string;
  ref: string;
}
export interface RiskRow {
  nr: string;
  risk: string;
  category: string | null;
  biv: boolean[] | null;
  measures: Measure[];
}
export interface RiskVersion {
  title: string;
  measureCount: number;
  refLabel: string;
  categoryLabel: string | null;
  hasBiv: boolean;
  rows: RiskRow[];
}

interface Props {
  data: RiskVersion;
  caption?: string;
}

const { data, caption = data.title } = Astro.props;
const hasCat = data.rows.some((r) => r.category);
const cats = [...new Set(data.rows.map((r) => r.category).filter(Boolean))] as string[];
const bivNames = t.bivNames;
const total = data.rows.length;
const splitRefs = (ref: string) =>
  ref
    .split(/[;,]\s*/)
    .map((s) => s.trim())
    .filter(Boolean);
---

<div class="riskset" data-riskset data-total={total} data-l-count={t.count} data-l-filtered={t.countFiltered}>
  <div class="riskset__bar" role="search">
    <label class="field riskset__search">
      <span class="sr-only">{t.searchLabel}</span>
      <Icon name="magnifying-glass" />
      <input
        class="input"
        type="search"
        placeholder={t.searchPlaceholder}
        autocomplete="off"
        spellcheck="false"
        data-q
      />
    </label>
    {
      hasCat && cats.length > 1 && (
        <label class="riskset__filter">
          <span class="sr-only">{fill(t.filterBy, { label: data.categoryLabel ?? t.categoryFallback })}</span>
          <select class="select" data-cat>
            <option value="">{data.categoryLabel === 'Domein' ? t.allDomains : t.allCategories}</option>
            {cats.map((c) => (
              <option value={c}>{c}</option>
            ))}
          </select>
        </label>
      )
    }
    {
      data.hasBiv && (
        <label class="riskset__filter">
          <span class="sr-only">{t.filterBiv}</span>
          <select class="select" data-biv>
            <option value="">{t.allBiv}</option>
            {bivNames.map((n, i) => (
              <option value={i}>{n}</option>
            ))}
          </select>
        </label>
      )
    }
    <p class="riskset__count" aria-live="polite" data-count>
      {fill(t.count, { n: total })}
    </p>
  </div>

  <table class="risk-table" role="table">
    <caption class="sr-only">{caption}</caption>
    <thead role="rowgroup">
      <tr role="row">
        <th scope="col" role="columnheader" class="rt-nr">{t.colNr}</th>
        <th scope="col" role="columnheader" class="rt-risk">{t.colRisk}</th>
        {
          hasCat && (
            <th scope="col" role="columnheader" class="rt-cat">
              {data.categoryLabel}
            </th>
          )
        }
        {
          data.hasBiv && (
            <th scope="col" role="columnheader" class="rt-biv">
              <abbr title={bivNames.join(', ')}>{t.colBiv}</abbr>
            </th>
          )
        }
        <th scope="col" role="columnheader" class="rt-measures">
          {t.colMeasures} <span class="rt-reflabel">({data.refLabel})</span>
        </th>
      </tr>
    </thead>
    <tbody role="rowgroup">
      {
        data.rows.map((r) => (
          <tr role="row" data-cat={r.category ?? ''} data-biv={r.biv ? r.biv.map((b) => (b ? 1 : 0)).join('') : ''}>
            <td role="cell" class="rt-nr">
              <span class="rt-nr__badge">{r.nr}</span>
            </td>
            <td role="cell" class="rt-risk">
              {r.risk}
            </td>
            {hasCat && (
              <td role="cell" class="rt-cat">
                {r.category && <span class="rt-chip">{r.category}</span>}
              </td>
            )}
            {data.hasBiv && (
              <td role="cell" class="rt-biv">
                <span class="biv" aria-hidden="true">
                  {t.bivLetters.map((l, i) => (
                    <span class:list={['biv__l', { 'is-on': r.biv?.[i] }]} title={bivNames[i]}>
                      {l}
                    </span>
                  ))}
                </span>
                <span class="sr-only">
                  {r.biv && r.biv.some(Boolean)
                    ? fill(t.affects, { list: bivNames.filter((_, i) => r.biv?.[i]).join(', ') })
                    : t.noBiv}
                </span>
              </td>
            )}
            <td role="cell" class="rt-measures">
              <span class="rt-mlabel" aria-hidden="true">
                {t.colMeasures}
              </span>
              <ol class="measures">
                {r.measures.map((m) => (
                  <li>
                    {m.name && <span class="measures__name">{m.name}</span>}
                    {m.ref && (
                      <span class="measures__refs">
                        {splitRefs(m.ref).map((ref) => (
                          <span class="ref">{ref}</span>
                        ))}
                      </span>
                    )}
                  </li>
                ))}
              </ol>
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
  <div class="riskset__empty" hidden data-empty>
    <Icon name="magnifying-glass" />
    <p>{t.empty}</p>
    <button type="button" class="btn btn--sm btn--ghost" data-reset>{t.reset}</button>
  </div>
</div>

<script>
  const norm = (s: string) =>
    s
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '');

  const supportsHighlight = typeof CSS !== 'undefined' && 'highlights' in CSS;
  const highlight = supportsHighlight ? new Highlight() : null;
  if (highlight) CSS.highlights.set('risk-search', highlight);

  document.querySelectorAll<HTMLElement>('[data-riskset]').forEach((root) => {
    const q = root.querySelector<HTMLInputElement>('[data-q]')!;
    const cat = root.querySelector<HTMLSelectElement>('[data-cat]');
    const biv = root.querySelector<HTMLSelectElement>('[data-biv]');
    const count = root.querySelector<HTMLElement>('[data-count]')!;
    const empty = root.querySelector<HTMLElement>('[data-empty]')!;
    const table = root.querySelector<HTMLTableElement>('table')!;
    const total = Number(root.dataset.total);
    const rows = [...root.querySelectorAll<HTMLTableRowElement>('tbody tr')].map((tr) => ({
      tr,
      text: norm(tr.textContent ?? ''),
    }));
    let ranges: Range[] = [];

    const paint = (terms: string[]) => {
      if (!highlight) return;
      ranges.forEach((r) => highlight.delete(r));
      ranges = [];
      if (!terms.length) return;
      for (const { tr } of rows) {
        if (tr.hidden) continue;
        const walker = document.createTreeWalker(tr, NodeFilter.SHOW_TEXT);
        let node: Node | null;
        while ((node = walker.nextNode())) {
          if ((node.parentElement as HTMLElement).closest('[aria-hidden="true"]')) continue;
          const value = norm(node.textContent ?? '');
          for (const t of terms) {
            let i = value.indexOf(t);
            while (i !== -1) {
              const range = new Range();
              range.setStart(node, i);
              range.setEnd(node, i + t.length);
              ranges.push(range);
              highlight.add(range);
              i = value.indexOf(t, i + t.length);
            }
          }
        }
      }
    };

    const update = () => {
      const terms = norm(q.value).split(/\s+/).filter(Boolean);
      const c = cat?.value ?? '';
      const b = biv?.value ?? '';
      let shown = 0;
      for (const { tr, text } of rows) {
        const ok =
          terms.every((t) => text.includes(t)) &&
          (!c || tr.dataset.cat === c) &&
          (!b || tr.dataset.biv?.[Number(b)] === '1');
        tr.hidden = !ok;
        if (ok) shown++;
      }
      const filtered = shown !== total;
      const fill = (tpl: string, v: Record<string, number>) => tpl.replace(/\{(\w+)\}/g, (m, k) => (k in v ? String(v[k]) : m));
      count.textContent = filtered
        ? fill(root.dataset.lFiltered!, { shown, total })
        : fill(root.dataset.lCount!, { n: total });
      empty.hidden = shown > 0;
      table.toggleAttribute('data-empty-table', shown === 0);
      paint(terms);
    };

    q.addEventListener('input', update);
    cat?.addEventListener('change', update);
    biv?.addEventListener('change', update);
    root.querySelector('[data-reset]')?.addEventListener('click', () => {
      q.value = '';
      if (cat) cat.value = '';
      if (biv) biv.value = '';
      update();
      q.focus();
    });
    if (q.value || cat?.value || biv?.value) update();
  });
</script>

<style>
  .riskset {
    --bar-gap: 0.75rem;
  }

  .riskset__bar {
    display: grid;
    gap: var(--bar-gap);
    align-items: center;
    margin-bottom: 1.25rem;
  }

  .riskset__count {
    margin: 0;
    font-size: var(--fs-sm);
    font-weight: 600;
    color: var(--navy);
  }

  @media (min-width: 720px) {
    .riskset__bar {
      grid-template-columns: minmax(16rem, 1fr) repeat(auto-fit, minmax(12rem, max-content));
    }

    .riskset__count {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 1100px) {
    .riskset__bar {
      grid-template-columns: minmax(18rem, 26rem) auto auto 1fr;
    }

    .riskset__count {
      grid-column: auto;
      justify-self: end;
    }
  }

  .riskset__filter .select {
    min-width: 12rem;
  }

  /* ---------- Table ---------- */
  .risk-table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    font-size: var(--fs-sm);
    color: var(--ink);
  }

  .risk-table[data-empty-table] thead {
    display: none;
  }

  .risk-table th,
  .risk-table td {
    text-align: left;
    vertical-align: top;
  }

  .risk-table thead th {
    position: sticky;
    top: var(--header-h);
    z-index: 2;
    padding: 0.85rem 1rem;
    background: var(--navy);
    color: var(--white);
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .risk-table thead th:first-child {
    border-top-left-radius: var(--radius-s);
  }

  .risk-table thead th:last-child {
    border-top-right-radius: var(--radius-s);
  }

  .risk-table abbr {
    text-decoration: none;
    cursor: help;
  }

  .rt-reflabel {
    color: var(--yellow);
    text-transform: none;
    letter-spacing: 0;
    font-weight: 600;
  }

  .risk-table tbody td {
    padding: 1rem;
    border-bottom: 1px solid var(--line);
    background: var(--white);
    transition: background-color 0.15s;
  }

  .risk-table tbody tr:nth-child(even) td {
    background: #fafbfd;
  }

  .risk-table tbody tr:hover td {
    background: var(--yellow-50);
  }

  .risk-table tbody td:first-child {
    border-left: 1px solid var(--line);
  }

  .risk-table tbody td:last-child {
    border-right: 1px solid var(--line);
  }

  .rt-nr {
    width: 4rem;
  }

  .rt-risk {
    width: 34%;
    font-weight: 600;
    line-height: 1.5;
  }

  .rt-cat {
    width: 11rem;
  }

  .rt-biv {
    width: 7rem;
  }

  .rt-nr__badge {
    display: inline-grid;
    place-items: center;
    min-width: 2.1rem;
    height: 2.1rem;
    padding-inline: 0.4rem;
    border-radius: 999px;
    background: var(--yellow);
    color: var(--navy);
    font-weight: 800;
    font-size: var(--fs-xs);
  }

  .rt-chip {
    display: inline-block;
    padding: 0.3em 0.75em;
    border-radius: 999px;
    background: var(--surface);
    color: var(--navy);
    font-size: var(--fs-xs);
    font-weight: 600;
    line-height: 1.35;
  }

  .biv {
    display: inline-flex;
    gap: 0.25rem;
  }

  .biv__l {
    display: grid;
    place-items: center;
    width: 1.6rem;
    height: 1.6rem;
    border-radius: 0.4rem;
    border: 1.5px dashed var(--line);
    color: #b5b8c8;
    font-size: 0.75rem;
    font-weight: 800;
  }

  .biv__l.is-on {
    border: 0;
    background: var(--navy);
    color: var(--yellow);
  }

  .rt-mlabel {
    display: none;
  }

  .measures {
    display: grid;
    gap: 0.55rem;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: m;
  }

  .measures li {
    counter-increment: m;
    position: relative;
    padding-left: 1.6rem;
    line-height: 1.45;
  }

  .measures li::before {
    content: counter(m);
    position: absolute;
    left: 0;
    top: 0.1em;
    display: grid;
    place-items: center;
    width: 1.15rem;
    height: 1.15rem;
    border-radius: 50%;
    background: var(--surface);
    color: var(--navy);
    font-size: 0.65rem;
    font-weight: 800;
  }

  .measures__name {
    margin-right: 0.4rem;
  }

  .measures__refs {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    vertical-align: 0.05em;
  }

  .ref {
    display: inline-block;
    padding: 0.1em 0.5em;
    border: 1px solid var(--line);
    border-radius: 0.35rem;
    background: var(--white);
    color: var(--navy);
    font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    font-size: 0.72rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .riskset__empty {
    display: grid;
    justify-items: center;
    gap: 0.75rem;
    padding: 3rem 1.5rem;
    border: 1.5px dashed var(--line);
    border-radius: var(--radius-s);
    text-align: center;
    color: var(--muted);
  }

  .riskset__empty[hidden] {
    display: none;
  }

  .riskset__empty p {
    margin: 0;
  }

  .riskset__empty :global(.icon) {
    font-size: 1.5rem;
    color: var(--navy);
  }

  /* ---------- Small screens: rows become cards ---------- */
  @media (max-width: 899.98px) {
    .risk-table,
    .risk-table tbody,
    .risk-table tr,
    .risk-table td {
      display: block;
      width: auto;
    }

    .risk-table thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
    }

    .risk-table tbody {
      display: grid;
      gap: 0.875rem;
    }

    .risk-table tbody tr {
      display: grid;
      grid-template-columns: auto 1fr auto;
      align-items: center;
      gap: 0.75rem 0.6rem;
      padding: 1.1rem;
      border: 1px solid var(--line);
      border-radius: var(--radius-s);
      background: var(--white);
      box-shadow: var(--shadow-s);
    }

    .risk-table tbody tr[hidden] {
      display: none;
    }

    .risk-table tbody td,
    .risk-table tbody tr:nth-child(even) td,
    .risk-table tbody tr:hover td {
      padding: 0;
      border: 0;
      background: none;
    }

    .rt-nr {
      grid-column: 1;
      grid-row: 1;
    }

    .rt-cat {
      grid-column: 2;
      grid-row: 1;
      min-width: 0;
    }

    .rt-biv {
      grid-column: 3;
      grid-row: 1;
    }

    .rt-risk {
      grid-column: 1 / -1;
      font-size: var(--fs-body);
    }

    .rt-risk,
    .rt-measures {
      hyphens: auto;
    }

    .rt-measures {
      grid-column: 1 / -1;
      padding-top: 0.85rem !important;
      border-top: 1px dashed var(--line) !important;
    }

    .rt-mlabel {
      display: block;
      margin-bottom: 0.6rem;
      color: var(--muted);
      font-size: var(--fs-xs);
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }
  }
</style>

<style is:global>
  ::highlight(risk-search) {
    background-color: var(--yellow);
    color: var(--navy);
  }
</style>
