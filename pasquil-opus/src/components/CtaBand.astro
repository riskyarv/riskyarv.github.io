---
import Icon from './Icon.astro';
import { site } from '../data/site';
import layout from '@content/layout.json';

interface Props {
  lang?: 'nl' | 'en';
}

const { lang = 'nl' } = Astro.props;
const t = layout.cta[lang];
---

<section class="cta-band" aria-labelledby="cta-title">
  <div class="panel bg-yellow cta-band__panel">
    <div class="container cta-band__inner">
      <div>
        <p class="eyebrow">{t.eyebrow}</p>
        <h2 id="cta-title">{t.title}</h2>
        <p class="lead">{t.text}</p>
      </div>
      <div class="btn-row">
        <a class="btn" href={`mailto:${site.email}`}><Icon name="envelope" /> {site.email}</a>
        <a class="btn btn--ghost" href={t.services.href}>{t.services.label} <Icon name="arrow-right" /></a>
      </div>
    </div>
    <svg class="cta-band__lock" viewBox="0 0 120 140" aria-hidden="true">
      <path d="M30 60V40a30 30 0 0 1 60 0v6" fill="none" stroke="currentColor" stroke-width="12" stroke-linecap="round" />
      <rect x="10" y="60" width="100" height="76" rx="16" fill="currentColor" />
    </svg>
  </div>
</section>

<style>
  .cta-band {
    padding-block: var(--panel-gutter);
  }

  .cta-band__panel {
    padding-block: clamp(3rem, 2rem + 4vw, 5rem);
  }

  .cta-band__inner {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 1.5rem 3rem;
    align-items: end;
  }

  .cta-band h2 {
    max-width: 18ch;
  }

  .cta-band .lead {
    max-width: 46ch;
    margin-bottom: 0;
  }

  .cta-band__lock {
    position: absolute;
    right: -2rem;
    bottom: -3.5rem;
    width: clamp(160px, 22vw, 280px);
    color: rgb(255 255 255 / 0.28);
    rotate: -12deg;
    pointer-events: none;
  }

  @media (min-width: 900px) {
    .cta-band__inner {
      grid-template-columns: 1fr auto;
    }
  }
</style>
