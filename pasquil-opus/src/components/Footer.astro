---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import logo from '../assets/img/logo-white.png';
import { site } from '../data/site';
import layout from '@content/layout.json';

const year = new Date().getFullYear();

const f = layout.footer;
---

<footer class="site-footer bg-navy" lang="nl">
  <div class="container container--wide">
    <div class="footer-grid">
      <div class="footer-brand">
        <a href="/" class="footer-logo" aria-label={f.logoLabel}>
          <Image src={logo} alt="" width={150} densities={[1.5, 2]} />
        </a>
        <p>{f.tagline}</p>
        <a class="social" href={site.linkedin} target="_blank" rel="noopener" aria-label={f.linkedinLabel}>
          <Icon name="linkedin-in" />
        </a>
      </div>

      {
        f.columns.map((col) => (
          <nav class="footer-col" aria-label={col.title}>
            <h2>{col.title}</h2>
            <ul role="list">
              {col.links.map((l) => (
                <li>
                  <a href={l.href}>{l.label}</a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }

      <div class="footer-col">
        <h2>{f.contactTitle}</h2>
        <ul role="list" class="contact-list">
          <li>
            <a href={site.maps} target="_blank" rel="noopener">
              <Icon name="location-dot" />
              <span>{site.street}<br />{site.city}</span>
            </a>
          </li>
          <li>
            <a href={`mailto:${site.email}`}>
              <Icon name="envelope" />
              <span>{site.email}</span>
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p>© {year} {f.copyright}</p>
      <ul role="list">
        {
          f.bottomLinks.map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding-top: clamp(3.5rem, 2.5rem + 4vw, 5.5rem);
    font-size: var(--fs-sm);
  }

  .footer-grid {
    display: grid;
    gap: 2.5rem clamp(1.25rem, 0.5rem + 3vw, 2rem);
    grid-template-columns: minmax(0, 1fr);
  }

  @media (max-width: 519px) {
    nav.footer-col ul {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 1.25rem;
    }
  }

  @media (min-width: 520px) {
    .footer-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .footer-brand {
    grid-column: 1 / -1;
    max-width: 30ch;
  }

  .footer-logo {
    display: inline-block;
    margin-bottom: 1.25rem;
  }

  .footer-logo img {
    width: 150px;
    height: auto;
  }

  .social {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.08);
    color: var(--white);
    transition:
      background-color 0.2s,
      color 0.2s;
  }

  .social:hover {
    background: var(--yellow);
    color: var(--navy);
  }

  .footer-col h2 {
    margin-bottom: 1rem;
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--yellow);
  }

  .footer-col ul {
    display: grid;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-col a {
    color: rgb(255 255 255 / 0.84);
    text-decoration: none;
    transition: color 0.2s;
  }

  .footer-col a:hover {
    color: var(--yellow);
  }

  .contact-list a {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
  }

  .contact-list :global(.icon) {
    margin-top: 0.3em;
    color: var(--yellow);
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    align-items: center;
    justify-content: space-between;
    margin-top: clamp(2.5rem, 2rem + 3vw, 4rem);
    padding-block: 1.5rem calc(1.5rem + env(safe-area-inset-bottom));
    border-top: 1px solid rgb(255 255 255 / 0.12);
    font-size: var(--fs-xs);
    color: rgb(255 255 255 / 0.6);
  }

  .footer-bottom p {
    margin: 0;
  }

  .footer-bottom ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-bottom a {
    color: inherit;
    text-decoration: none;
  }

  .footer-bottom a:hover {
    color: var(--yellow);
  }

  @media (min-width: 640px) {
    .footer-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1000px) {
    .footer-grid {
      grid-template-columns: 1.4fr 1fr 1fr 1fr;
    }

    .footer-brand {
      grid-column: auto;
    }
  }
</style>
