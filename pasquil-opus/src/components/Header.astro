---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import logo from '../assets/img/logo-white.png';
import { fill, nav, site, type NavItem } from '../data/site';
import layout from '@content/layout.json';

const h = layout.header;

const path = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;

const inSection = (item: NavItem): boolean =>
  path === item.href || !!item.children?.some((c) => path.startsWith(c.href) || inSection(c));
---

<header class="site-header" lang="nl">
  <div class="container container--wide bar">
    <a href="/" class="brand" aria-label={h.logoLabel}>
      <Image src={logo} alt="" width={132} densities={[1.5, 2]} loading="eager" fetchpriority="high" />
    </a>

    <nav class="nav-desktop" aria-label={h.menuLabel}>
      <ul class="menu" role="list">
        {
          nav.map((item, i) => (
            <li class:list={['menu__item', { 'has-sub': item.children }]}>
              <a
                href={item.href}
                class:list={['menu__link', { 'is-active': inSection(item) }]}
                aria-current={path === item.href ? 'page' : undefined}
              >
                {item.label}
              </a>
              {item.children && (
                <>
                  <button
                    class="menu__toggle"
                    type="button"
                    aria-expanded="false"
                    aria-controls={`dd-${i}`}
                    aria-label={fill(h.submenuLabel, { label: item.label })}
                  >
                    <Icon name="chevron-down" />
                  </button>
                  <div class="dropdown" id={`dd-${i}`}>
                    <ul class="dropdown__list" role="list">
                      {item.children.map((child) => (
                        <li>
                          <a
                            href={child.href}
                            class="dd-link"
                            aria-current={path === child.href ? 'page' : undefined}
                          >
                            {child.icon && (
                              <span class="dd-link__icon">
                                <Icon name={child.icon} />
                              </span>
                            )}
                            <span>{child.label}</span>
                          </a>
                          {child.children && (
                            <ul class="dd-chips" role="list">
                              {child.children.map((g) => (
                                <li>
                                  <a href={g.href} aria-current={path === g.href ? 'page' : undefined}>
                                    {g.label}
                                  </a>
                                </li>
                              ))}
                            </ul>
                          )}
                        </li>
                      ))}
                    </ul>
                    {i === 0 && (
                      <a class="dropdown__foot" href={item.href}>
                        {h.allServices} <Icon name="arrow-right" />
                      </a>
                    )}
                  </div>
                </>
              )}
            </li>
          ))
        }
      </ul>
    </nav>

    <a class="btn btn--sm header-cta" href={`mailto:${site.email}`}>
      <Icon name="envelope" />
      <span>{h.mailButton}</span>
    </a>

    <button class="burger" type="button" popovertarget="mobile-menu" aria-label={h.openMenu} aria-controls="mobile-menu">
      <Icon name="bars" />
    </button>
  </div>
</header>

<div id="mobile-menu" class="drawer" popover aria-label={h.drawerLabel} lang="nl">
  <div class="drawer__top">
    <a href="/" class="brand" aria-label={h.logoLabel}>
      <Image src={logo} alt="" width={120} densities={[1.5, 2]} />
    </a>
    <button class="drawer__close" type="button" popovertarget="mobile-menu" popovertargetaction="hide" aria-label={h.closeMenu}>
      <Icon name="xmark" />
    </button>
  </div>
  <nav aria-label={h.mobileMenuLabel}>
    <ul class="m-menu" role="list">
      {
        nav.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={['m-link', { 'is-active': inSection(item) }]}
              aria-current={path === item.href ? 'page' : undefined}
            >
              {item.label}
              <Icon name="arrow-right" />
            </a>
            {item.children && (
              <ul class="m-sub" role="list">
                {item.children.map((child) => (
                  <li>
                    <a href={child.href} aria-current={path === child.href ? 'page' : undefined}>
                      {child.icon && <Icon name={child.icon} />}
                      {child.label}
                    </a>
                    {child.children && (
                      <ul class="m-chips" role="list">
                        {child.children.map((g) => (
                          <li>
                            <a href={g.href} aria-current={path === g.href ? 'page' : undefined}>
                              {g.label}
                            </a>
                          </li>
                        ))}
                      </ul>
                    )}
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
    </ul>
  </nav>
  <div class="drawer__foot">
    <a class="btn" href={`mailto:${site.email}`}><Icon name="envelope" /> {site.email}</a>
    <a class="btn btn--ghost" href={site.linkedin} target="_blank" rel="noopener"><Icon name="linkedin-in" /> {h.linkedinButton}</a>
  </div>
</div>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgb(11 29 81 / 0.94);
    color: var(--white);
    backdrop-filter: saturate(1.6) blur(14px);
    -webkit-backdrop-filter: saturate(1.6) blur(14px);
    view-transition-name: site-header;
  }

  @supports (animation-timeline: scroll()) {
    .site-header {
      animation: header-raise linear both;
      animation-timeline: scroll();
      animation-range: 0 160px;
    }
  }

  @keyframes header-raise {
    to {
      box-shadow: 0 12px 32px -14px rgb(3 10 31 / 0.6);
      background: rgb(11 29 81 / 0.86);
    }
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    min-height: var(--header-h);
  }

  .brand {
    display: block;
    flex: none;
    margin-right: auto;
    padding-block: 0.5rem;
    border-radius: 8px;
  }

  .brand img {
    width: clamp(108px, 90px + 3vw, 132px);
    height: auto;
  }

  /* ---- Desktop nav ---- */
  .nav-desktop {
    display: none;
  }

  .menu {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .menu__item {
    position: relative;
    display: flex;
    align-items: center;
  }

  .menu__link {
    position: relative;
    padding: 0.6rem 0.8rem;
    border-radius: 999px;
    color: var(--white);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition:
      color 0.2s,
      background-color 0.2s;
  }

  .has-sub .menu__link {
    padding-right: 0.2rem;
  }

  .menu__link:hover,
  .menu__item:hover > .menu__link {
    color: var(--yellow);
  }

  .menu__link.is-active {
    color: var(--yellow);
  }

  .menu__link.is-active::after {
    content: '';
    position: absolute;
    left: 0.8rem;
    right: 0.8rem;
    bottom: 0.15rem;
    height: 2px;
    border-radius: 2px;
    background: var(--yellow);
  }

  .has-sub .menu__link.is-active::after {
    right: 0.2rem;
  }

  .menu__toggle {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: inherit;
    font-size: 0.65rem;
    transition:
      transform 0.25s var(--ease-out),
      color 0.2s;
  }

  .menu__item:hover > .menu__toggle,
  .menu__toggle[aria-expanded='true'] {
    color: var(--yellow);
    transform: rotate(180deg);
  }

  .dropdown {
    position: absolute;
    top: 100%;
    left: -0.5rem;
    min-width: 330px;
    padding-top: 0.75rem;
    visibility: hidden;
    opacity: 0;
    translate: 0 6px;
    transition:
      opacity 0.2s var(--ease-out),
      translate 0.2s var(--ease-out),
      visibility 0s linear 0.2s;
  }

  .menu__item:hover > .dropdown,
  .menu__toggle[aria-expanded='true'] + .dropdown {
    visibility: visible;
    opacity: 1;
    translate: 0 0;
    transition-delay: 0s;
  }

  .dropdown__list {
    margin: 0;
    padding: 0.5rem;
    list-style: none;
    border-radius: 20px 20px 0 0;
    background: var(--white);
    box-shadow: var(--shadow-l);
  }

  .dropdown__list:last-child {
    border-radius: 20px;
  }

  .dd-link {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.6rem 0.75rem;
    border-radius: 12px;
    color: var(--navy);
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.3;
    text-decoration: none;
    transition: background-color 0.2s;
  }

  .dd-link:hover,
  .dd-link[aria-current='page'] {
    background: var(--surface);
  }

  .dd-link__icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 10px;
    background: var(--yellow-100);
    color: var(--navy);
    font-size: 0.95rem;
    transition: background-color 0.2s;
  }

  .dd-link:hover .dd-link__icon {
    background: var(--yellow);
  }

  .dd-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0 0 0.35rem;
    padding: 0 0.75rem 0 3.85rem;
    list-style: none;
  }

  .dd-chips a {
    display: inline-block;
    padding: 0.25rem 0.7rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--navy);
    font-size: 0.75rem;
    font-weight: 600;
    text-decoration: none;
    transition:
      background-color 0.2s,
      border-color 0.2s;
  }

  .dd-chips a:hover,
  .dd-chips a[aria-current='page'] {
    border-color: var(--yellow);
    background: var(--yellow);
  }

  .dropdown__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.85rem 1.25rem;
    border-radius: 0 0 20px 20px;
    background: var(--yellow);
    color: var(--navy);
    font-size: 0.875rem;
    font-weight: 700;
    text-decoration: none;
    box-shadow: var(--shadow-l);
  }

  .dropdown__foot :global(.icon) {
    transition: transform 0.25s var(--ease-out);
  }

  .dropdown__foot:hover :global(.icon) {
    transform: translateX(4px);
  }

  .header-cta {
    display: none;
  }

  .header-cta {
    --btn-bg-hover: var(--white);
    --btn-fg-hover: var(--navy);
  }

  /* ---- Burger ---- */
  .burger {
    display: grid;
    place-items: center;
    width: 2.875rem;
    height: 2.875rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: var(--yellow);
    color: var(--navy);
    font-size: 1.15rem;
    transition: transform 0.2s;
  }

  .burger:active {
    transform: scale(0.94);
  }

  @media (min-width: 1120px) {
    .nav-desktop {
      display: block;
    }

    .header-cta {
      display: inline-flex;
    }

    .burger {
      display: none;
    }
  }

  /* ---- Drawer (popover) ---- */
  .drawer {
    position: fixed;
    inset: 0 0 0 auto;
    width: min(26rem, 100%);
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0 0 calc(1.5rem + env(safe-area-inset-bottom));
    border: 0;
    background: var(--navy);
    color: var(--white);
    overflow-y: auto;
    overscroll-behavior: contain;
    transform: translateX(100%);
    transition:
      transform 0.4s var(--ease-out),
      overlay 0.4s allow-discrete,
      display 0.4s allow-discrete;
  }

  .drawer:popover-open {
    transform: none;
  }

  @starting-style {
    .drawer:popover-open {
      transform: translateX(100%);
    }
  }

  .drawer::backdrop {
    background: rgb(6 17 49 / 0);
    transition:
      background-color 0.4s,
      overlay 0.4s allow-discrete,
      display 0.4s allow-discrete;
  }

  .drawer:popover-open::backdrop {
    background: rgb(6 17 49 / 0.55);
  }

  @starting-style {
    .drawer:popover-open::backdrop {
      background: rgb(6 17 49 / 0);
    }
  }

  @supports not selector(:popover-open) {
    .drawer {
      display: none;
    }

    .drawer[data-open] {
      display: block;
      z-index: 200;
      transform: none;
    }
  }

  .drawer__top {
    position: sticky;
    top: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: var(--header-h);
    padding-inline: var(--gutter);
    background: var(--navy);
  }

  .drawer__top img {
    width: 112px;
    height: auto;
  }

  .drawer__close {
    display: grid;
    place-items: center;
    width: 2.875rem;
    height: 2.875rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.1);
    color: var(--white);
    font-size: 1.2rem;
  }

  .m-menu {
    margin: 0.5rem 0 0;
    padding: 0 var(--gutter);
    list-style: none;
  }

  .m-menu > li {
    padding-block: 0.4rem;
    border-bottom: 1px solid rgb(255 255 255 / 0.1);
  }

  .m-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: 0.6rem;
    color: var(--white);
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .m-link :global(.icon) {
    font-size: 0.9rem;
    color: var(--yellow);
    opacity: 0.8;
  }

  .m-link.is-active {
    color: var(--yellow);
  }

  .m-sub {
    margin: 0 0 0.5rem;
    padding: 0;
    list-style: none;
  }

  .m-sub > li > a {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-block: 0.5rem;
    color: rgb(255 255 255 / 0.85);
    font-weight: 600;
    text-decoration: none;
  }

  .m-sub > li > a :global(.icon) {
    color: var(--yellow);
  }

  .m-sub a[aria-current='page'] {
    color: var(--yellow);
  }

  .m-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0 0 0.5rem;
    padding: 0 0 0 1.75rem;
    list-style: none;
  }

  .m-chips a {
    display: inline-block;
    padding: 0.35rem 0.8rem;
    border: 1px solid rgb(255 255 255 / 0.25);
    border-radius: 999px;
    color: var(--white);
    font-size: 0.8125rem;
    font-weight: 600;
    text-decoration: none;
  }

  .m-chips a[aria-current='page'] {
    border-color: var(--yellow);
    background: var(--yellow);
    color: var(--navy);
  }

  .drawer__foot {
    display: grid;
    gap: 0.75rem;
    padding: 1.75rem var(--gutter) 0;
  }

  .drawer__foot .btn--ghost {
    --btn-fg: var(--white);
    --btn-border: rgb(255 255 255 / 0.4);
    --btn-bg-hover: var(--white);
    --btn-fg-hover: var(--navy);
  }

  :global(html:has(.drawer:popover-open)),
  :global(html:has(.drawer[data-open])) {
    overflow: hidden;
  }
</style>

<script>
  const items = document.querySelectorAll<HTMLLIElement>('.menu__item.has-sub');
  const closeAll = (except?: Element) => {
    items.forEach((li) => {
      const btn = li.querySelector('.menu__toggle');
      if (btn && btn !== except) btn.setAttribute('aria-expanded', 'false');
    });
  };

  items.forEach((li) => {
    const btn = li.querySelector<HTMLButtonElement>('.menu__toggle')!;
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') === 'true';
      closeAll(btn);
      btn.setAttribute('aria-expanded', String(!open));
    });
    li.addEventListener('focusout', (e) => {
      if (!li.contains(e.relatedTarget as Node | null)) btn.setAttribute('aria-expanded', 'false');
    });
  });

  document.addEventListener('click', (e) => {
    if (!(e.target as Element).closest('.menu__item.has-sub')) closeAll();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const open = document.querySelector<HTMLButtonElement>('.menu__toggle[aria-expanded="true"]');
    if (open) {
      closeAll();
      open.focus();
    }
  });

  const drawer = document.getElementById('mobile-menu')!;
  const supportsPopover = typeof HTMLElement !== 'undefined' && 'popover' in HTMLElement.prototype;

  if (!supportsPopover) {
    document.querySelectorAll<HTMLButtonElement>('[popovertarget="mobile-menu"]').forEach((b) =>
      b.addEventListener('click', () => {
        const hide = b.getAttribute('popovertargetaction') === 'hide';
        drawer.toggleAttribute('data-open', hide ? false : !drawer.hasAttribute('data-open'));
      }),
    );
  }

  // Close the drawer when following an in-page anchor
  drawer.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      if (supportsPopover && drawer.matches(':popover-open')) drawer.hidePopover();
      drawer.removeAttribute('data-open');
    }),
  );

  // Close the drawer if the viewport grows to desktop
  matchMedia('(min-width: 1120px)').addEventListener('change', (e) => {
    if (e.matches && supportsPopover && drawer.matches(':popover-open')) drawer.hidePopover();
  });
</script>
