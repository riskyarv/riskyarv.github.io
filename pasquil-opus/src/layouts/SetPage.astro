---
import Base from './Base.astro';
import PageHero from '../components/PageHero.astro';
import RiskTable, { type RiskVersion } from '../components/RiskTable.astro';
import SetNav from '../components/SetNav.astro';
import Icon from '../components/Icon.astro';
import { fill, sets, site } from '../data/site';
import setUi from '@content/set-ui.json';

interface Props {
  title: string;
  crumb: string;
  description: string;
  current: keyof typeof sets;
  versions: RiskVersion[];
  note?: string;
}

const { title, crumb, description, current, versions, note } = Astro.props;
const [latest, ...older] = versions;
const ui = setUi.setPage;
const crumbs = [...ui.crumbs, { label: crumb }];
const latestHeading = latest.title === title ? ui.defaultHeading : latest.title;
const mail = `mailto:${site.email}?subject=${encodeURIComponent(fill(ui.mailSubject, { title }))}`;
---

<Base title={title} description={description} crumbs={crumbs}>
  <PageHero eyebrow={ui.eyebrow} title={title} crumbs={crumbs}>
    <div class="set-intro rich">
      <slot />
    </div>
    <aside slot="media" class="card card--navy facts" aria-label={ui.factsLabel}>
      <dl>
        <div>
          <dt>{ui.facts.risks}</dt>
          <dd>{latest.rows.length}</dd>
        </div>
        <div>
          <dt>{ui.facts.measures}</dt>
          <dd>{fill(ui.facts.measuresValue, { n: latest.measureCount })}</dd>
        </div>
        <div>
          <dt>{ui.facts.reference}</dt>
          <dd>{latest.refLabel}</dd>
        </div>
        {
          latest.hasBiv && (
            <div>
              <dt>{ui.facts.biv}</dt>
              <dd>{ui.facts.bivValue}</dd>
            </div>
          )
        }
      </dl>
      <div class="facts__actions">
        <a class="btn" href="#set">
          <Icon name="table-list" /> {ui.viewSet}
        </a>
        <a class="btn btn--ghost" href={mail}>
          <Icon name="download" /> {ui.requestExcel}
        </a>
      </div>
    </aside>
  </PageHero>

  <section id="set" class="section set" aria-labelledby="set-title">
    <div class="container container--wide">
      <div class="set__head">
        <h2 id="set-title">{latestHeading}</h2>
        {note && <p class="pill pill--soft set__note">{note}</p>}
      </div>
      <RiskTable data={latest} caption={`${title} – ${latest.title}`} />

      {
        older.length > 0 && (
          <div class="older">
            <h2 class="older__title">{ui.olderVersions}</h2>
            {older.map((v) => (
              <details class="acc">
                <summary>
                  <span>{v.title}</span>
                  <span class="acc__chev" aria-hidden="true">
                    <Icon name="chevron-down" />
                  </span>
                </summary>
                <div class="acc__body">
                  <RiskTable data={v} caption={`${title} – ${v.title}`} />
                </div>
              </details>
            ))}
          </div>
        )
      }
    </div>
  </section>

  <section class="section section--flush-top">
    <div class="container container--wide">
      <SetNav current={current} title={ui.otherSets} />
    </div>
  </section>
</Base>

<style>
  .set-intro {
    max-width: 68ch;
  }

  .set-intro :global(p) {
    font-size: var(--fs-body);
  }

  .set-intro :global(p:last-child) {
    margin-bottom: 0;
  }

  .facts {
    width: 100%;
    max-width: 26rem;
    margin-inline: auto;
    box-shadow: var(--shadow-l);
  }

  .facts dl {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem 1rem;
    margin: 0 0 1.75rem;
  }

  .facts dt {
    color: rgb(255 255 255 / 0.65);
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .facts dd {
    margin: 0.2rem 0 0;
    color: var(--white);
    font-weight: 700;
    line-height: 1.3;
  }

  .facts div:first-child dd {
    color: var(--yellow);
    font-size: 2.25rem;
    line-height: 1;
  }

  .facts__actions {
    display: grid;
    gap: 0.6rem;
  }

  .facts__actions .btn {
    justify-content: center;
  }

  .set__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    margin-bottom: 1.5rem;
  }

  .set__head h2 {
    margin: 0;
  }

  .set__note {
    margin: 0;
  }

  .older {
    margin-top: clamp(2.5rem, 2rem + 2vw, 4rem);
  }

  .older__title {
    font-size: var(--fs-h4);
  }

  .older .acc__body {
    padding-top: 1rem;
  }
</style>
